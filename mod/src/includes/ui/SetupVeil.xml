<!-- Two panels rather than a ProgressBar: a ProgressBar would not span
     the screen, and its fill is driven by a percentage attribute we cannot
     stretch. Here the track is the full width and the fill is a percentage
     OF THE TRACK, so the rule reaches both edges whatever the resolution.
     Flush with the top of the UI frame, which is as high as it goes: TTS
     starts that frame a little under the window's edge and covers the gap
     with its own toolbar, so a rule nudged above the frame is hidden
     rather than raised - tried, and it vanished. -->
<Panel
  id="setupVeilBar"
  active="true"
  rectAlignment="UpperCenter"
  offsetXY="0 0"
  width="100%"
  height="6"
  color="#00000000"
>
  <Panel
    id="setupVeilBarFill"
    rectAlignment="MiddleLeft"
    width="0%"
    height="100%"
    color="#E8801AFF"
  />
</Panel>
