<!-- Progress rule, the one form every loading indicator
     takes: a thin band flush with the top of the UI frame, full width,
     filling left to right. Sized off the TRACK (a percentage width), so
     it reaches both edges whatever the resolution. Flush with the top of
     the frame, which is as high as it goes: TTS starts the frame a little
     under the window's edge and hides anything nudged above it. -->
<Panel
  id="progressRule"
  active="false"
  rectAlignment="UpperCenter"
  offsetXY="0 0"
  width="100%"
  height="6"
  color="#00000000"
>
  <Panel
    id="progressRuleFill"
    rectAlignment="MiddleLeft"
    width="0%"
    height="100%"
    color="#E8801AFF"
  />
</Panel>
