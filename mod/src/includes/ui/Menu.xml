<!-- The floating menu spawned in the bottom right corner-->

<!-- Height should be NUM_BUTTONS * 58. The last one is a placeholder the
     extended overlays toggle takes over (see ExtendedOverlays). -->
<VerticalLayout
  height="232"
  id="legionFloatingMenu"
  offsetXY="-6 60"
  rectAlignment="LowerRight"
  spacing="6"
  width="52"
>
  <Button fontSize="10" image="uiButton" colors="#FFFFFF|#D8D8D8|#B8B8B8|#FFFFFF" textColor="#E6E8EE" onClick="toggleWelcomeDialog">Welcome</Button>
  <Button fontSize="10" image="uiButton" colors="#FFFFFF|#D8D8D8|#B8B8B8|#FFFFFF" textColor="#E6E8EE" onClick="toggleChessClockUI" tooltip="Toggle using chess clocks this game">Chess Clocks</Button>
  <Button fontSize="10" image="uiButton" colors="#FFFFFF|#D8D8D8|#B8B8B8|#FFFFFF" textColor="#E6E8EE" interactable="false">-</Button>
  <!-- Empty slot, kept so the menu keeps its place above TTS's own buttons. -->
  <Panel color="#00000000" />
</VerticalLayout>

