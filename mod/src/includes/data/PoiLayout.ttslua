-- POI (point of interest) guide layouts.
--
-- First parameter is X, the second is Y, origin is lower left.
-- Grid is 6 inches.
-- I overlayed all map cards and entered the coordinates for all
-- current maps. Might be worth a double check, it didn't align
-- perfectly with the POI overlay, which is missing many of the new ones.
function getPoiLayout6x3()
  return {
    {1, 2},
    {1, 3},
    {2, 4},
    {2.5, 2},
    {3, 1.5},
    {3, 2},
    {3, 3},
    {3, 4.5},
    {3, 5},
    {4, 1},
    {4, 2},
    {4, 4},
    {4.5, 3},
    {5, 4},
    {6, 1},
    {6, 2},
    {6, 3},
    {6, 4},
    {6, 5},
    {7, 2},
    {7.5, 3},
    {8, 2},
    {8, 4},
    {8, 5},
    {9, 1},
    {9, 1.5},
    {9, 3},
    {9, 4},
    {9, 4.5},
    {9.5, 4},
    {10, 2},
    {11, 3},
    {11, 4},
  }
end

-- Half-length 3x3 battlefield: X and Y, same as above
function getPoiLayout3x3()
  return {
    {1, 2},
    {1, 3},
    {1, 4},
    {3, 1},
    {3, 3},
    {3, 5},
    {5, 2},
    {5, 3},
    {5, 4},
  }
end

-- The POIs of each primary Objective's map card, on the grids above. Keys are
-- upper case card names.
local MISSION_POIS_6X3 = {
  ["CLOSE THE POCKET"]     = {{3, 3}, {6, 3}, {9, 3}},
  ["BUNKER ASSAULT"]       = {{4, 2}, {4, 4}, {8, 2}, {8, 4}},
  ["BREAKTHROUGH"]         = {{1, 3}, {4, 1}, {8, 5}, {11, 3}},
  ["INTERCEPT SIGNALS"]    = {{3, 3}, {6, 1}, {6, 5}, {9, 3}},
  ["RECOVER THE RESEARCH"] = {{2, 4}, {3, 2}, {5, 4}, {7, 2}, {9, 4}, {10, 2}},
  ["SHIFTING PRIORITIES"]  = {{1, 2}, {3, 3}, {6, 3}, {9, 3}, {11, 4}},
  ["OUTFLANK"]             = {{2, 4}, {6, 2}, {6, 4}, {10, 2}},
  ["CAULDRON"]             = {{3, 1.5}, {3, 4.5}, {4.5, 3}, {7.5, 3}, {9, 1.5}, {9, 4.5}},
  ["CONTACT, CONTACT!"]    = {{3, 5}, {6, 1}, {6, 3}, {6, 5}, {9, 1}},
  ["PAYLOAD"]              = {{2.5, 2}, {6, 3}, {9.5, 4}},
}

local MISSION_POIS_3X3 = {
  ["CLOSE THE POCKET"]  = {{1, 3}, {3, 3}, {5, 3}},
  ["BUNKER ASSAULT"]    = {{1, 2}, {1, 4}, {5, 2}, {5, 4}},
  ["INTERCEPT SIGNALS"] = {{1, 3}, {3, 1}, {3, 5}, {5, 3}},
}

function getMissionPoiLayout(cardName, isThreeByThree)
  local cards = isThreeByThree and MISSION_POIS_3X3 or MISSION_POIS_6X3
  return cards[cardName:upper()]
end
