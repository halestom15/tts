        -- 100mm x 200mm oblong
        rangeRulers.snail = "https://raw.githubusercontent.com/ironsquadronfr-hub/tts/isq-qol/mod/data/isq-overlay-assets/projector_200mm_oblong_metal_v1.unity3d"
