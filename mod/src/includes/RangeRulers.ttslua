
-- ================== Buttons that follow the visible face ==================
-- A button is attached to the token's frame: once the token is flipped it is
-- seen from behind and its in-plane angle reads negated. Vanilla answered with
-- two superposed buttons, the second at {0,0,180}. That passes for an "R" and
-- fails as soon as a second letter joins it: two "E"s read as an "H". So each
-- token keeps ONE button per label and reorients it on flip.
--
-- One angle per button: its placement angle phi on the circle, measured from
-- the token's front. The label turns the opposite way, so face up the button
-- is { 0, -phi, 0 } and face down { 0, phi, 180 }; phi = 0 gives exactly the
-- old second button. A button that shows up on the other side once flipped is
-- the same object seen from the other face, not a defect.
--
-- The helpers live here because the POI token has its own copy of the button
-- and does not use TokenWithRangeRuler. onRotate is NOT defined here: this
-- file is also included by Global, the order token and the bomb carts, which
-- have no button to reorient. Every button owner declares its own onRotate
-- calling reorientButtons.
TOKEN_BUTTON_RADIUS = 0.7

orientedButtons = {}

function uprightButtonRotation(phi, flip)
  if flip == nil then flip = self.getRotation().z end
  if flip > 90 and flip < 270 then return { 0, phi, 180 } end
  return { 0, -phi, 0 }
end

function ringButtonPosition(phi)
  local r = math.rad(phi)
  return { TOKEN_BUTTON_RADIUS * math.sin(r), 0.1, TOKEN_BUTTON_RADIUS * math.cos(r) }
end

-- Call once a button is created so it follows the visible face.
function registerOrientedButton(label, phi)
  table.insert(orientedButtons, { label = label, phi = phi })
end

function reorientButtons(flip)
  for _, e in ipairs(orientedButtons) do
    for _, b in ipairs(self.getButtons() or {}) do
      if b.label == e.label then
        self.editButton({ index = b.index, rotation = uprightButtonRotation(e.phi, flip) })
        break
      end
    end
  end
end
-- =============================================================================

require('!/data/RangeRulerLinks')
require('!/ExtendedOverlaysBridge')

function showRangeOnHoveredModel(hoverObject)
  -- When a player has turned the extended overlays on for the table, draw
  -- the range with the Projector renderer instead. When they are off, which is
  -- the default, everything below runs unchanged.
  if extendedOverlaysOn() then
    -- Only unit figures, range-bearing tokens and bomb carts; an assigned
    -- order token passes for a unit otherwise (see isRangeHoverTarget)
    -- and got range bands drawn around the token itself.
    if hoverObject and hoverObject.interactable
        and isRangeHoverTarget(hoverObject) then
      toggleOverlayRange({figGUID = hoverObject.getGUID(), forceFigMode = true})
    end
    return
  end
  clearRangeRulers()
  if hoverObject then
    if hoverObject.interactable then
      if selectedUnitObj == hoverObject then
        selectedUnitObj = nil
        return
      else
        spawnRangeRuler(hoverObject)
        selectedUnitObj = hoverObject
      end
    end
  else
    selectedUnitObj = nil
  end
end

-- Refactor this to work with the refactored spawnRangeRuler()
function clearRangeRulers()
  if rangeRuler ~= nil then
    destroyObject(rangeRuler)
    rangeRuler = nil
  end

  noRulers = true
end


function spawnRangeRuler(rangeSourceObject, projectorBundleOverride)
  if rangeSourceObject == nil then 
    return 
  end

  local rulerBundleToSpawn = ""

  if projectorBundleOverride ~= nil then
    rulerBundleToSpawn = projectorBundleOverride
  else
    -- Get unit data from leader if leader hovered
    local unitData = rangeSourceObject.getTable("unitData")

    -- If leader not hovered, get leader GUID from mini data to get unit data
    if not unitData then
      local unitLeader = getObjectFromGUID(rangeSourceObject.getVar("leaderGUID"))
      if not unitLeader then
        return 
      end
      unitData = unitLeader.getTable("unitData")
      if not unitData then
        return 
      end
    end

    local baseSize = unitData.baseSize
    local rulerBundleTable = getRangeRulerLinks()
    rulerBundleToSpawn = rulerBundleTable[baseSize] 
  end

  basePos = rangeSourceObject.getPosition()
  baseRot = rangeSourceObject.getRotation()

  rangeRuler = spawnObject({
    type = "Custom_AssetBundle",
    position = {basePos.x, basePos.y + 20, basePos.z},
    rotation = {90, baseRot.y, 0},
    scale = {0,0,0} -- 0 scale will hide TTS default box and won't impact projector
  })

  rangeRuler.setCustomObject({
    type = 0,
    assetbundle = rulerBundleToSpawn
  })

  rangeRuler.setLock(true)
  rangeRuler.setName("Range Ruler")
  luaScript = "targetGUID = '"..rangeSourceObject.getGUID().."'\n function onFixedUpdate()\nif targetGUID ~= nil then\n targetObj = getObjectFromGUID(targetGUID)\n local targetPosition = targetObj.getPosition()\n self.setPosition({targetPosition.x, targetPosition.y + 20, targetPosition.z})\n self.setRotation({0,targetObj.getRotation().y,0})\n end\n end"
  rangeRuler.setLuaScript(luaScript)

  noRulers = false
end
