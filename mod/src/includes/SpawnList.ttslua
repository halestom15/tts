require('!/common/Tablex')

-- How many lists are spawning right now, red's and blue's together. The two
-- list builders are separate objects with separate scripts, so neither can see
-- the other's state: the count lives on the Global, which both reach. Pass 0 to
-- read it. A reload starts the Global fresh, so the count cannot survive as a
-- stale value.
local function countImports(delta)
  local count = (Global.getVar("isqImportsInFlight") or 0) + delta
  if count < 0 then
    count = 0
  end
  if delta ~= 0 then
    Global.setVar("isqImportsInFlight", count)
  end
  return count
end

local function initListSpawner(params)
  local deck = params.deck
  local shelf = params.shelf
  local globals = params.globals
  local color = params.color
  local mount = params.mount
  local orientation = params.orientation
  local unitTokens = params.unitTokens
  local scripts = params.scripts or {}

  local function dealCommandCard(name, contingency)
    local card = deck:spawnCommandCard(name, contingency)
    if contingency then
      card.highlightOn({0, 1, 1})
    end
    local hand = globals.handPos[color:lower()]
    card.setRotation(hand.rot)
    card.setPosition(hand.pos)
  end

  local function drawBattlefieldCard(height, name, type, scenario)
    local card = deck:spawnBattleCard(type, name, scenario)
    local position = mount.getPosition()
    position.y = position.y + 0.23 + (height * 0.1)
    card.setPosition(position)
    local rotation = mount.getRotation()
    rotation.z = 180
    card.setRotation(rotation)
  end

  local function buildBattlefieldDeck(
    tasks,
    scenario,
    objectives,
    deployments,
    conditions
  )
    local i = 0
    local function queueCard(card, type)
      local height = i
      table.insert(tasks, function()
        drawBattlefieldCard(height, card, type, scenario)
        return true
      end)
      i = i + 1
    end
    for _, card in ipairs(objectives) do
      queueCard(card, "objective")
    end
    for _, card in ipairs(deployments) do
      queueCard(card, "deployment")
    end
    for _, card in ipairs(conditions) do
      queueCard(card, "condition")
    end
  end

  local function computeSpawnPositions(index)
    local templatePos = globals[color:lower() .. "TemplatePos"][index]
    local adjustedPos = tablex.shallow(templatePos)
    local templateHalfWidth = globals.spawnOffsets.templateHalfWidth
    local templateHalfHeight = globals.spawnOffsets.templateHalfHeight
    local cardHeight = globals.spawnOffsets.cardHeight
    local cardWidth = globals.spawnOffsets.unitCardWidth
    local padding = globals.spawnOffsets.padding
    local xOffset = 1
    local zOffset = 1

    if index > 10 then
      -- TODO: Support unit ID tokens > 10.
      index = index - 10
      adjustedPos.z = adjustedPos.z - (templateHalfHeight * 0.3)
    end

    if adjustedPos.z < 0 then
      xOffset = -1
      zOffset = -1
      padding = padding * -1
      cardHeight = cardHeight * -1
      templateHalfWidth = templateHalfWidth * -1
      templateHalfHeight = templateHalfHeight * -1
    end

    adjustedPos.x = adjustedPos.x + templateHalfWidth - padding
    adjustedPos.z = adjustedPos.z - templateHalfHeight + cardHeight

    return {
      adjustedPos = adjustedPos,
      xOffset     = xOffset,
      zOffset     = zOffset,
    }
  end

  local function computeUpgradePositions(index)
    local cardHeight = globals.spawnOffsets.cardHeight
    local cardWidth = globals.spawnOffsets.unitCardWidth
    local upgradeCardWidth = globals.spawnOffsets.upgradeCardWidth
    local padding = globals.spawnOffsets.padding

    local xOffset = 0
    if (index == 1 or index == 4 or index == 7) then
      xOffset = cardWidth - upgradeCardWidth / 2 + padding
    elseif (index == 2 or index == 5) then
      xOffset = -cardWidth / 2 + upgradeCardWidth / 2
    elseif (index == 3 or index == 6) then
      xOffset = upgradeCardWidth / 2 + padding / 2
    end

    local zOffset = 0
    if index > 1 then
      zOffset = cardHeight + padding
    end
    if index >= 5 then
      zOffset = zOffset * 2
    end

    return {
      xOffset     = xOffset,
      zOffset     = zOffset,
    }
  end

  local function initialZOffset(upgradeCount)
    local cardHeight = globals.spawnOffsets.cardHeight
    local padding = globals.spawnOffsets.padding
    local initialZOffset = cardHeight + padding
    if upgradeCount > 1 and upgradeCount < 5 then
      initialZOffset = initialZOffset + (cardHeight + padding)
    elseif upgradeCount > 4 then
      initialZOffset = initialZOffset + (cardHeight + padding) * 2
    end
    return initialZOffset
  end

  local function computeMiniPositions(
    adjustedPos,
    index,
    base,
    xOffset,
    zOffset,
    upgradeCount
  )
    local templateHalfWidth = globals.spawnOffsets.templateHalfWidth
    local unitCardWidth = globals.spawnOffsets.unitCardWidth
    local padding = globals.spawnOffsets.padding

    local baseRadius = base * 0.5
    local initialXOffset = unitCardWidth * 0.5 - baseRadius
    local position = {
      x = adjustedPos.x + initialXOffset * xOffset,
      y = adjustedPos.y,
      z = adjustedPos.z,
    }
    local paddedBase = (base + padding)
    local basesPerRow = math.max(1, math.abs(math.floor(templateHalfWidth * 2.0 / paddedBase)))
    local whole, part = math.modf(index/(basesPerRow + 1));
    local zIndex = whole
    local totalZOffset = initialZOffset(upgradeCount)
    if index > basesPerRow then
      local zFromCard = zOffset * zIndex
      if adjustedPos.z > 0 then
        zFromCard = -zOffset * zIndex
      end
      totalZOffset = totalZOffset - (paddedBase * zFromCard)     
    end
    local newIndex = (index - (basesPerRow * zIndex) - 1)
    local baseOffset = paddedBase * xOffset
    local totalXOffset = (baseOffset * newIndex)
    local xDir = xOffset * -1
    if adjustedPos.z < 0 then
      xDir = xDir * -1
    end

    return simpleTranslatePos(
      position,
      totalXOffset * xDir,
      totalZOffset * zOffset
    )
  end

  local function getGlobalTint()
    return getObjectFromGUID(Global.getVar("gameDataGUID")).getTable("battlefieldTint")
  end

  -- Names and describes every model of a unit, then queues one job per
  -- model to attach its script: giving an object a script costs a flat
  -- ~70-140 ms in TTS however small the script is (creating the script
  -- context; measured 21/08 - size, spawn path and attach order change
  -- nothing), so attaching a whole squad's scripts in one frame is what
  -- used to freeze it. The strings are built here and now - every model
  -- already exists, so every GUID is known.
  function initializeMini(pMiniTable, push)
    local strColor = pMiniTable.colorSide
    strColor = strColor:gsub("^%l", string.upper)

    -- detect leader units
    local leaderInt = pMiniTable.leaderIndex

    local leaderGUID = pMiniTable.miniObjs[leaderInt].obj.getGUID()

    for i, objEntry in pairs(pMiniTable.miniObjs) do
      -- init mini script
      local selectedMiniScript = ""

      -- SET NAME
      local displayName = pMiniTable.displayName or objEntry.name
      objEntry.obj.setName(strColor.. " "..displayName)
      selectedMiniScript = selectedMiniScript .. "colorSide = '"..pMiniTable.colorSide.."'\nminiName = \""..objEntry.name.."\"\n"

      -- SET LEADER GUID
      selectedMiniScript = selectedMiniScript .. "leaderGUID = \"" .. leaderGUID .. "\"\n"

      if i == leaderInt then
        -- DESCRIPTION
        local description = ""

        for p, upgradeName in pairs(pMiniTable.upgrades) do
          description = description .. upgradeName .. "\n"
        end
        objEntry.obj.setDescription(description)

        -- miniGUIDs

        local silhHeight = 0
        local silhOffset = 0

        -- TODO: Handle JSON Import because the miniTable isn't fully populated 
        local silhType = "custom"
        if pMiniTable.type then
          if string.find(pMiniTable.type, "Trooper") then
              silhType = "notched"
            if pMiniTable.baseSize == small then
              silhType = "small"
            end
          else
            silhHeight = pMiniTable.silhData[1]
            silhOffset = pMiniTable.silhData[2]
          end
        else
          silhHeight = pMiniTable.silhData[1]
          silhOffset = pMiniTable.silhData[2]
        end

        local miniGUIDsScript = "miniGUIDs = {}\n"
        for n, objEntry in pairs(pMiniTable.miniObjs) do
          miniGUIDsScript = miniGUIDsScript .. "miniGUIDs["..n.."] = '" .. objEntry.obj.getGUID() .. "'\n"
        end

        local miniName = ""
        if pMiniTable.name then
          if pMiniTable.name ~= nil then
            miniName = pMiniTable.name:lower()
          end
        end

        selectedMiniScript = selectedMiniScript .. miniGUIDsScript ..
          "cardGUID = \"" .. pMiniTable.unitCardGUID ..
          "\"\n unitName = \"".. miniName ..
          "\"\n silhType = \"".. silhType ..
          "\"\n silhHeight = \"".. silhHeight ..
          "\"\n silhOffset = \"".. silhOffset ..
          "\"\n commandName = \"".. pMiniTable.commandName ..
          "\"\n commandType = \"".. pMiniTable.commandType ..
          "\"\n selectedSpeed = ".. pMiniTable.selectedSpeed ..
          "\n baseSize = \"".. pMiniTable.baseSize ..
          "\"\n unitID = " .. pMiniTable.unitID ..
          "\n unitIDTokenGUID = \"".. pMiniTable.unitIDTokenGUID ..
          "\"\n" .. globals.modelMiniScript
      else
        objEntry.obj.use_snap_points = false
      end

      -- SET SCRIPT
      local obj = objEntry.obj
      local script = selectedMiniScript
      push(function()
        obj.setLuaScript(script)
        return true
      end)
    end
  end

  -- Spawns one command token; its script attaches in a follow-up job (the
  -- attach costs a flat ~70-140 ms, see initializeMini).
  function initializeCommandToken(cData, push)
    local tokenObj = spawnObject({
      type           = "Custom_Model",
      rotation       = cData.rot,
      position       = cData.pos,
    })
    tokenObj.setCustomObject({
      mesh = "https://steamusercontent-a.akamaihd.net/ugc/786359883314446513/4DBBAC00ABA5EABE88C2A86C3311C3FB6645FF25/",
      collider = "https://steamusercontent-a.akamaihd.net/ugc/785234780866339915/85F7E717B9EFBE0396126CA673DF17EAFEC7D451/",
      diffuse = Global.getTable("commandTokenData")[color:lower()][cData.commandType],
      type = 0,
      material = 3
    })
    tokenObj.setName(cData.name)
    -- Set the objects script.
    -- Note this is used instead of "setTable()" because onLoad/onSave is buggy with stuff that stacks.
    local luaScript = string.format(
      "_G.unitData = {" ..
      "  baseSize      = [[%s]],\n" ..
      "  colorSide     = [[%s]],\n" ..
      "  commandType   = [[%s]],\n" ..
      "  fixedArc      = %s,\n" ..
      "  fixedMove     = %s,\n" ..
      "  selectedSpeed = %s,\n" ..
      "  strafeMove    = %s,\n" ..
      "}\n\n",
      cData.baseSize,
      color:lower(),
      cData.commandType,
      tostring(cData.baseSize:lower() ~= "small"),
      tostring(cData.baseSize:lower() ~= "small"),
      tostring(cData.selectedSpeed),
      tostring(cData.baseSize:lower() ~= "small")
    )
    push(function()
      tokenObj.setLuaScript(luaScript .. globals.tokenScript)
      return true
    end)
  end

  -- Runs once every model of the unit exists: writes the mini scripts, then
  -- queues one job per command token so their spawns are paced like every
  -- other object.
  local function initializeMiniAndCommandToken(
    index,
    unitInfo,
    faction,
    miniData,
    push
  )
    -- A unit the card data does not know, and one whose models are not
    -- implemented yet, both come back from the shelf as a bare list of dud
    -- models: none of the fields read below exist on it, and the rank alone
    -- took the whole import down with an "attempt to index a nil value"
    -- naming nothing. The dud model and its card are already on the table,
    -- so say which unit it was and let the rest of the list spawn.
    if unitInfo == nil or unitInfo.rank == nil then
      broadcastToAll(
        "\"" .. tostring(miniData.name) .. "\" is not in the card data: "
          .. "spawned as a placeholder, with no command token.",
        {1, 0.6, 0}
      )
      return
    end

    -- TODO: Remove mapping.
    if faction == "Empire" then
      faction = "Imperial"
    end
    -- TODO: Support homebrew factions better than this
    if not ({
      imperial   = 1,
      rebel      = 1,
      separatist = 1,
      republic   = 1,
      mercenary = 1,
    })[faction:lower()] then
      faction = "Imperial"
    end
    local rankAndRemap = unitInfo.rank
    if rankAndRemap:lower() == "special forces" then
      rankAndRemap = "specialForces"
    end
    local commandType =
      faction:lower() ..
      rankAndRemap:lower():gsub("^%l", string.upper)
    local commandName =
      color:gsub("^%l", string.upper) ..
      " " ..
      faction:gsub("^%l", string.upper) ..
      " " ..
      unitInfo.rank:gsub("^%l", string.upper) ..
      " Command Token"
    miniData.name = unitInfo.name
    miniData.baseSize = unitInfo.size
    miniData.commandName = commandName
    miniData.commandType = commandType
    miniData.selectedSpeed = unitInfo.speed
    miniData.silhData = miniData.silhData or {}
    miniData.type = miniData.type

    initializeMini(miniData, push)

    local commandTray = getObjectFromGUID(
      Global.getTable("commandTokenTrayData")[color:lower()][commandType]
    )
    local position = commandTray.getPosition()
    position.y = position.y + 0.5 + (0.2 * index)
    local rotation = self.getRotation()
    rotation.y = rotation.y + 180

    local tokensToSpawn = 1
    if unitInfo.tokens then
      tokensToSpawn = unitInfo.tokens
    end
    for i = tokensToSpawn, 1, -1 do
      push(function()
        initializeCommandToken({
          name          = commandName,
          commandType   = commandType,
          pos           = position,
          rot           = rotation,
          baseSize      = unitInfo.size,
          selectedSpeed = unitInfo.speed,
        }, push)
        return true
      end)
    end
  end

  -- Queues everything one unit needs, in order: its cards, its unit ID
  -- token, one job per model, then - once every model exists - the mini
  -- scripts and one job per command token. `push` appends a job to the
  -- running import's queue; a job returns true when it spawned an object.
  local function spawnUnit(
    unit,
    index,
    faction,
    push
  )
    --Min JSON Payload
    local name = unit.name
    local upgrades = unit.upgrades or {}
    local loadout = unit.loadout or {}

    -- Shared by the jobs below, which run in queue order: the unit card job
    -- fills them, the later jobs read them.
    local offsets
    local rotation
    local miniData

    push(function()
      --if we spawn via JSON we don't have
      --enough data to parse silhs anymore...
      --we need type and any custom values
      --so load everything off the deck if needed
      local completeUnitData

      local type = unit.type
      local silhData = unit.silhData or {}

      -- A unit the deck cannot find comes back as nil, and reading a
      -- silhouette or a type off it took the whole import down with an
      -- "attempt to index a nil value" naming nothing. The card itself has
      -- always spawned as a labelled dud in that case, so follow the same
      -- rule: skip what the data cannot supply and carry on with the list.
      -- The player is told once, by the command-token stage, which sees the
      -- same unit come back from the shelf as a bare dud.
      if unit.silhData == nil or unit.type == nil then
        completeUnitData = deck:getUnitByFactionAndName(faction, name)
      end

      if unit.silhData == nil then
        silhData = {}
        if completeUnitData ~= nil and completeUnitData.silhouette ~= nil then
          for k, v in pairs(completeUnitData.silhouette) do
            table.insert(silhData, completeUnitData.silhouette[k])
          end
        end
      end

      if unit.type == nil and completeUnitData ~= nil then
        type = completeUnitData.type
      end

      -- Prep unit card spawn locations.
      offsets = computeSpawnPositions(index)
      rotation = self.getRotation()
      local unitCard = deck:spawnUnitCard(faction, name)
      unitCard.setPosition(offsets.adjustedPos)
      unitCard.setRotation({0, rotation.y + 180, 0})

      miniData = {
        name            = name,
        colorSide       = color:lower(),
        miniObjs        = {},
        -- Intentionally omitted. We use the name assigned from the spawned model.
        displayName     = nil,
        unitID          = index,
        unitCardGUID    = unitCard.getGUID(),
        leaderIndex     = 1,
        upgrades        = upgrades,
        type            = type,
        silhData        = silhData
      }
      return true
    end)

    -- Spawn upgrade cards.
    for i, upgrade in ipairs(upgrades) do
      push(function()
        local uOffsets = computeUpgradePositions(i)
        local upgradeCard = deck:spawnUpgradeCard(upgrade)
        upgradeCard.setPosition(
          simpleTranslatePos(
            offsets.adjustedPos,
            uOffsets.xOffset * offsets.xOffset * -1,
            uOffsets.zOffset * offsets.zOffset
          )
        )
        upgradeCard.setRotation({0, rotation.y + 180, 0})
        return true
      end)
    end

    -- Spawn unit ID token.
    push(function()
      local unitId = unitTokens.takeObject({
        position = offsets.adjustedPos,
        rotation = {0, rotation.y + 180, 0},
        smooth   = false,
      })

      local unitIdState = ((index - 1) % 10) + 1

      if unitIdState > 1 then
        unitId = unitId.setState(unitIdState)
      end

      miniData.unitIDTokenGUID = unitId.getGUID()
      return true
    end)

    -- Plan the models: one queued job per model, then the scripts and
    -- command tokens once the last one has spawned.
    push(function()
      -- Spawn loadout and addon cards.
      local additional = {
        position = offsets.adjustedPos,
        rotation  = rotation,
      }
      if #loadout > 0 then
        additional.callback = function(spawnedBag)
          for _, upgrade in ipairs(loadout) do
            local upgradeCard = deck:spawnUpgradeCard(upgrade)
            spawnedBag.putObject(upgradeCard)
          end
        end
      end
      shelf:spawnUnitModels({
        faction    = faction,
        name       = name,
        upgrades   = upgrades,
        additional = additional,
        scripts    = scripts,
        schedule   = push,
        callback   = function(model, modelIndex, base)
          local position = computeMiniPositions(
            offsets.adjustedPos,
            modelIndex,
            base,
            offsets.xOffset,
            offsets.zOffset,
            #upgrades
          )
          model.setPosition(position)
          model.setRotation({rotation.x, rotation.y + 180, rotation.z})
          model.setColorTint(getGlobalTint())
          table.insert(miniData.miniObjs, {
            obj    = model,
            name   = model.getName(),
            leader = modelIndex == miniData.leaderIndex,
          })
        end,
        done       = function(result)
          initializeMiniAndCommandToken(
            index,
            result,
            faction,
            miniData,
            push
          )
        end,
      })
      return false
    end)
  end

  return function(listData)
    -- The synchronous version spawned the whole list in the frame of the
    -- import: ~120 objects instantiated at once froze the table for
    -- seconds. Instead the import builds a queue of jobs and a pump spawns
    -- one object per frame, folding zero-spawn jobs into the same frame
    -- within a small time budget, so the table stays interactive while the
    -- list fills in.
    --
    -- A fresh import obsoletes any queue still draining (importing again
    -- while the previous list spawns): bumping the shared generation makes
    -- the old pump stop on its next frame. Intentionally a global: both
    -- imports run in this object's VM, whichever initListSpawner call they
    -- came from.
    __isqSpawnGeneration = (__isqSpawnGeneration or 0) + 1
    local generation = __isqSpawnGeneration

    -- One frozen schema per import; unpinned in the final task so anything
    -- outside an import keeps reading the live table.
    deck:pinSchema()
    shelf:pinSchema()

    -- Both players import into their own toast and their own share of the
    -- frame. The two builders are separate objects, so nothing here is
    -- visible from the other one: the toast is told apart by id, and the
    -- count of imports in flight lives on the Global, where both can see it.
    local suffix = color:lower() == "red" and "Red" or "Blue"
    local other = suffix == "Red" and "Blue" or "Red"
    local panelId = "importProgress" .. suffix
    local textId = "importProgressText" .. suffix
    local ruleId = "importRule" .. suffix
    local fillId = "importRuleFill" .. suffix
    local otherPanelId = "importProgress" .. other
    local otherRuleId = "importRule" .. other

    -- The toast and its rule take the top slot when they are the only ones
    -- up, and the one underneath when the other player is already
    -- importing. Slots go by arrival rather than by colour: pinned to a
    -- colour, a lone blue import hung its rule six pixels below the top
    -- edge and its toast eighty below its own, under empty screen.
    local function takeSlot(top)
      Global.UI.setAttribute(panelId, "offsetXY", top and "0 -28" or "0 -108")
      Global.UI.setAttribute(ruleId, "offsetXY", top and "0 0" or "0 -6")
    end

    -- An import already in flight on this object is the one being obsoleted
    -- above: its pump stops on its next frame and never reaches the closing
    -- task, so its seat in the count - and its slot - simply carries over
    -- to this import.
    if not __isqImportInFlight then
      __isqImportInFlight = true
      takeSlot(countImports(1) < 2)
    end

    local function closeImport()
      Global.UI.setAttribute(panelId, "active", false)
      Global.UI.setAttribute(ruleId, "active", false)
      deck:unpinSchema()
      shelf:unpinSchema()
      if __isqImportInFlight then
        __isqImportInFlight = false
        -- An import left running alone slides up into the top slot.
        if countImports(-1) > 0 then
          Global.UI.setAttribute(otherPanelId, "offsetXY", "0 -28")
          Global.UI.setAttribute(otherRuleId, "offsetXY", "0 0")
        end
      end
    end

    -- The importing banner (top of screen, in the Global UI): the
    -- spread-out spawn takes a few seconds, so say so - paced work reads
    -- as loading when it is labeled, and as lag when it is not. The
    -- progress rule fills unit by unit, tinted the importing player's color.
    local banner = "IMPORTING " .. color:upper() .. " LIST"
    Global.UI.setAttribute(fillId, "width", "0%")
    Global.UI.setValue(textId, banner)
    Global.UI.setAttribute(panelId, "active", true)
    Global.UI.setAttribute(ruleId, "active", true)

    -- `jobs` is the fine-grained queue the current unit expands into;
    -- `tasks` holds the coarse steps (each card deal, each unit, the final
    -- scenario call) in list order. Draining jobs before tasks makes a
    -- unit's models follow its own cards instead of every card in the list
    -- preceding every model.
    local jobs = {}
    local function push(job)
      table.insert(jobs, job)
    end
    local tasks = {}

    for _, c in ipairs(listData.commandCards) do
      table.insert(tasks, function()
        dealCommandCard(c, false)
        return true
      end)
    end
    for _, c in ipairs(listData.contingencies) do
      table.insert(tasks, function()
        dealCommandCard(c, true)
        return true
      end)
    end
    local scenario = listData.battlefieldDeck.scenario or "standard"
    buildBattlefieldDeck(
      tasks,
      scenario,
      listData.battlefieldDeck.objective,
      listData.battlefieldDeck.deployment,
      listData.battlefieldDeck.condition or listData.battlefieldDeck.conditions
    )
    local totalUnits = #listData.units
    for i, unit in ipairs(listData.units) do
      table.insert(tasks, function()
        Global.UI.setValue(
          textId,
          banner .. "  -  UNIT " .. i .. "/" .. totalUnits
        )
        Global.UI.setAttribute(
          fillId,
          "width",
          math.floor((i - 1) * 100 / totalUnits) .. "%"
        )
        spawnUnit(unit, i, listData.armyFaction, push)
        return false
      end)
    end
    table.insert(tasks, function()
      mount.call("setScenario", {name = scenario})
      closeImport()
      return false
    end)

    local function pump()
      if generation ~= __isqSpawnGeneration then
        return
      end
      -- Two lists importing at once would otherwise take 30ms each and hand
      -- the table a 60ms frame, which is the freeze this whole queue exists
      -- to avoid. Split the budget by the number of imports in flight.
      local deadline = os.clock() + 0.03 / math.max(1, countImports(0))
      repeat
        -- No shortcutting through table.remove(t, 1) here: TTS's Lua
        -- (MoonSharp) throws "position out of bounds" on an empty table
        -- where standard Lua returns nil.
        local job
        if #jobs > 0 then
          job = table.remove(jobs, 1)
        elseif #tasks > 0 then
          job = table.remove(tasks, 1)
        end
        if job == nil then
          return
        end
        -- A failing job abandons the rest of the queue, like a failing
        -- unit abandoned the rest of the synchronous pass - but the pins
        -- must not outlive the import, or everything the builder reads
        -- outside an import would keep seeing this frozen copy.
        local ok, spawned = pcall(job)
        if not ok then
          closeImport()
          error(spawned, 0)
        end
      until spawned or os.clock() >= deadline
      Wait.frames(pump, 1)
    end
    pump()
  end
end
