require('!/RangeRulers')

-- each token must define 'rangeKey' with key listed below

-- Token keys in RangeRulers Table
-- smokeToken = 18.8mm diameter (range 1)
-- token = 25.1mm diameter (range 1)
-- poi = 50.8mm diameter (range 0.5 aka 3in)

-- The button orientation helpers live in !/RangeRulers, shared with the POI
-- token, which does not use this include. onRotate receives the TARGET angle
-- before the object reaches it, so the argument is used: the current rotation
-- would still be the old one.
function onRotate(spin, flip, player_color, old_spin, old_flip)
  reorientButtons(flip)
end

function onLoad()
  rangeOn = false
  createButton(0)
end

function createButton(theta)
  self.createButton({
    click_function = "toggleRangeRuler",
    function_owner = self,
    label = "R",
    tooltip = "Spawn Range Ruler",
    position = ringButtonPosition(theta),
    rotation = uprightButtonRotation(theta),
    scale = {0.5, 0.5, 0.5},
    width = 400,
    height = 300,
    font_size = 200,
    color = {0, 0, 0, 1},
    font_color = {0.1212, 0.8127, 0, 1}
  })
  registerOrientedButton("R", theta)
end

function onDestroy()
  clearRangeRuler()
end

function toggleRangeRuler()
  -- extended overlays (see !/ExtendedOverlays): route this token's R button to
  -- the Projector renderer when they are on. Off by default, in which case
  -- everything below runs unchanged.
  if extendedOverlaysOn() then
    -- Clear before triggering in both branches: the hover hotkey writes to the
    -- same key as this token, so without the clear the first click would turn
    -- that overlay off while we set rangeOn = true, leaving the button
    -- inverted from then on.
    clearOverlayRange({figGUID = self.getGUID()})
    if rangeOn then
      rangeOn = false
    else
      triggerOverlayRange({figGUID = self.getGUID()})
      rangeOn = true
    end
    return
  end
  clearRangeRuler()
  rangeOn = not rangeOn
  if rangeOn then
    spawnTokenRangeRuler()
  end
end

function clearRangeRuler()
  if rangeRuler then
    destroyObject(rangeRuler)
    rangeRuler = nil
  end
end

function spawnTokenRangeRuler()
  local rangeRulerTable = getRangeRulerLinks()
  local tokenRulerBundle = rangeRulerTable[rangeKey]
  spawnRangeRuler(self, tokenRulerBundle)
end
